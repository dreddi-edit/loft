## Shared
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

## Database (PostgreSQL local / AlloyDB on GCP)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hair_simo

## Auth — local JWT fallback (dev, always works without GCP)
JWT_SECRET=replace-with-long-random-secret

## Auth — Identity Platform (production: set true + create users in Firebase)
GCP_IDENTITY_PLATFORM_ENABLED=false
GCP_FIREBASE_PROJECT_ID=

## Google Cloud Platform (leave empty for full local mode)
GCP_PROJECT_ID=

## Local dev toggles (no GCP required)
# Mock payments enabled automatically in development. Set false to disable.
PAYMENTS_MOCK_ENABLED=true

## GCP region & AI (only needed when GCP_PROJECT_ID is set)
GCP_REGION=europe-west6
GCP_VERTEX_LOCATION=europe-west1
GCP_GEMINI_MODEL=gemini-2.5-flash
GCP_DIALOGFLOW_AGENT_ID=
GCP_DIALOGFLOW_LOCATION=europe-west1

## Cloud Speech & TTS (Chirp / Chirp 3 HD) — set after GCP connect
GCP_STT_LANGUAGE_CODES=de-DE,it-IT,fr-FR,en-US
GCP_TTS_VOICE_DE=de-DE-Chirp3-HD-Charon
GCP_TTS_VOICE_IT=it-IT-Chirp3-HD-Charon
GCP_TTS_VOICE_FR=fr-FR-Chirp3-HD-Charon
GCP_TTS_VOICE_EN=en-US-Chirp3-HD-Charon

## Messaging & Tasks — set after GCP connect
GCP_PUBSUB_TOPIC_NOTIFICATIONS=hair-simo-notifications
GCP_CLOUD_TASKS_QUEUE=hair-simo-tasks
GCP_CLOUD_TASKS_HANDLER_URL=http://localhost:3000/api/tasks/notification
GCP_CLOUD_TASKS_SECRET=replace-with-random-secret
# Leave empty locally — notifications log to console. Set after Gmail API setup.
GCP_GMAIL_SENDER=

## Payments — Google Pay + PSP gateway (set after merchant onboarding)
GCP_GOOGLE_PAY_MERCHANT_ID=
GCP_PAYMENT_GATEWAY=
GCP_PAYMENT_GATEWAY_MERCHANT_ID=
GCP_PAYMENT_WEBHOOK_SECRET=replace-with-random-secret

## Admin demo users (seed)
ADMIN_OWNER_EMAIL=owner@hairsimo.local
ADMIN_MANAGER_EMAIL=manager@hairsimo.local
ADMIN_STAFF_EMAIL=staff@hairsimo.local

## Cron / scheduled jobs (reminder batch)
CRON_SECRET=replace-with-random-secret

## Optional observability
LOG_LEVEL=info
SENTRY_DSN=
