generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  owner
  manager
  staff
}

enum Channel {
  web
  whatsapp
  sms
  voice
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
  no_show
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  refunded
}

enum InventoryMovementType {
  adjustment
  purchase
  sale
  return
}

enum NotificationStatus {
  pending
  sent
  failed
  abandoned
}

enum WaitlistStatus {
  active
  notified
  converted
  expired
  cancelled
}

enum CustomerNoteKind {
  general
  formula
  allergy
  preference
}

enum DataRequestType {
  export
  erasure
}

enum DataRequestStatus {
  pending
  processing
  completed
  failed
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  locale       String        @default("en")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  staffProfile StaffProfile?
  roles        UserRole[]
}

model Role {
  id        String     @id @default(cuid())
  key       RoleKey    @unique
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  users     UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model StaffProfile {
  id               String                  @id @default(cuid())
  userId           String                  @unique
  displayName      String
  bio              String?
  phone            String?
  locale           String                  @default("en")
  isBookable       Boolean                 @default(true)
  googleCalendarId String?
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffServices    StaffService[]
  availability     StaffAvailabilityRule[]
  timeOffs         StaffTimeOff[]
  appointments     Appointment[]
  waitlistEntries  Waitlist[]
  recurringSeries  RecurringSeries[]
}

model Customer {
  id              String            @id @default(cuid())
  email           String?           @unique
  phone           String?           @unique
  firstName       String
  lastName        String
  locale          String            @default("en")
  sourceChannel   Channel           @default(web)
  marketingOptIn  Boolean           @default(false)
  deletedAt       DateTime?         @db.Timestamptz(3)
  anonymizedAt    DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  notes           CustomerNote[]
  appointments    Appointment[]
  consents        ConsentRecord[]
  conversations   Conversation[]
  callLogs        CallLog[]
  waitlistEntries Waitlist[]
  recurringSeries RecurringSeries[]
  dataRequests    DataRequest[]
  vouchers        Voucher[]

  @@index([deletedAt])
}

model CustomerNote {
  id         String           @id @default(cuid())
  customerId String
  note       String
  kind       CustomerNoteKind @default(general)
  authorId   String?
  pinned     Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, kind])
}

model Service {
  id              String               @id @default(cuid())
  slug            String               @unique
  category        String
  durationMin     Int
  bufferAfterMin  Int                  @default(10)
  priceCents      Int
  currency        String               @default("EUR")
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  translations    ServiceTranslation[]
  staffServices   StaffService[]
  appointments    Appointment[]
  waitlistEntries Waitlist[]
  recurringSeries RecurringSeries[]
}

model ServiceTranslation {
  id          String   @id @default(cuid())
  serviceId   String
  locale      String
  name        String
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@index([serviceId])
}

model StaffService {
  id        String       @id @default(cuid())
  staffId   String
  serviceId String
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([serviceId])
}

model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startMin  Int
  endMin    Int
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([dayOfWeek])
}

model StaffAvailabilityRule {
  id        String       @id @default(cuid())
  staffId   String
  dayOfWeek Int
  startMin  Int
  endMin    Int
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
}

model StaffTimeOff {
  id        String       @id @default(cuid())
  staffId   String
  startsAt  DateTime     @db.Timestamptz(3)
  endsAt    DateTime     @db.Timestamptz(3)
  reason    String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt, endsAt])
}

model Appointment {
  id                 String                     @id @default(cuid())
  customerId         String
  serviceId          String
  staffId            String?
  seriesId           String?
  startsAt           DateTime                   @db.Timestamptz(3)
  endsAt             DateTime                   @db.Timestamptz(3)
  locale             String                     @default("en")
  status             AppointmentStatus          @default(pending)
  sourceChannel      Channel                    @default(web)
  notes              String?
  cancellationReason String?
  depositRequired    Boolean                    @default(true)
  noShowFeeCents     Int                        @default(0)
  googleEventId      String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)
  customer           Customer                   @relation(fields: [customerId], references: [id])
  service            Service                    @relation(fields: [serviceId], references: [id])
  staff              StaffProfile?              @relation(fields: [staffId], references: [id])
  series             RecurringSeries?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  statusHistory      AppointmentStatusHistory[]
  payments           Payment[]
  notifications      NotificationLog[]
  verification       BookingVerification?
  reviewRequest      ReviewRequest?
  voucherRedemptions VoucherRedemption[]

  @@index([staffId, startsAt])
  @@index([startsAt, status])
  @@index([customerId])
  @@index([serviceId])
  @@index([seriesId])
  @@index([googleEventId])
}

model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  status        AppointmentStatus
  changedBy     String?
  reason        String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model Payment {
  id                 String              @id @default(cuid())
  appointmentId      String
  provider           String
  providerIntentId   String?
  idempotencyKey     String?             @unique
  amountCents        Int
  tipCents           Int                 @default(0)
  refundedCents      Int                 @default(0)
  currency           String              @default("EUR")
  mode               String
  status             PaymentStatus       @default(pending)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  appointment        Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  refunds            Refund[]
  voucherRedemptions VoucherRedemption[]

  @@index([appointmentId])
  @@index([status, createdAt])
}

model Refund {
  id            String   @id @default(cuid())
  paymentId     String
  amountCents   Int
  reason        String?
  providerRefId String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Conversation {
  id          String    @id @default(cuid())
  customerId  String?
  channel     Channel
  locale      String    @default("en")
  externalRef String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  customer    Customer? @relation(fields: [customerId], references: [id])
  messages    Message[]

  @@index([externalRef])
  @@index([customerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CallLog {
  id          String    @id @default(cuid())
  customerId  String?
  locale      String    @default("en")
  fromNumber  String?
  toNumber    String?
  summary     String
  actionTaken String
  fallback    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  customer    Customer? @relation(fields: [customerId], references: [id])

  @@index([createdAt])
  @@index([customerId])
}

model NotificationLog {
  id            String             @id @default(cuid())
  appointmentId String?
  channel       Channel
  recipient     String
  templateKey   String
  payload       Json
  status        NotificationStatus @default(pending)
  attempts      Int                @default(0)
  lastError     String?
  sentAt        DateTime?          @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([templateKey, sentAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model ConsentRecord {
  id         String   @id @default(cuid())
  customerId String
  type       String
  granted    Boolean
  source     String
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  name               String
  priceCents         Int
  stock              Int                 @default(0)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  inventoryMovements InventoryMovement[]

  @@index([name])
}

model InventoryMovement {
  id           String                @id @default(cuid())
  productId    String
  type         InventoryMovementType @default(adjustment)
  delta        Int
  balanceAfter Int
  reason       String                @default("")
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  actorRole  String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Waitlist {
  id                     String         @id @default(cuid())
  customerId             String
  serviceId              String
  staffId                String?
  earliestAt             DateTime       @db.Timestamptz(3)
  latestAt               DateTime       @db.Timestamptz(3)
  locale                 String         @default("en")
  channel                Channel        @default(web)
  status                 WaitlistStatus @default(active)
  notifiedAt             DateTime?      @db.Timestamptz(3)
  convertedAppointmentId String?
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)
  customer               Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service                Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff                  StaffProfile?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([serviceId, status])
  @@index([earliestAt, latestAt])
  @@index([customerId])
  @@index([staffId])
}

model BookingVerification {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  tokenHash     String      @unique
  expiresAt     DateTime    @db.Timestamptz(3)
  verifiedAt    DateTime?   @db.Timestamptz(3)
  sentCount     Int         @default(0)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Voucher {
  id                 String              @id @default(cuid())
  code               String              @unique
  initialCents       Int
  remainingCents     Int
  currency           String              @default("EUR")
  expiresAt          DateTime?           @db.Timestamptz(3)
  active             Boolean             @default(true)
  issuedToCustomerId String?
  note               String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  issuedToCustomer   Customer?           @relation(fields: [issuedToCustomerId], references: [id], onDelete: SetNull)
  redemptions        VoucherRedemption[]

  @@index([issuedToCustomerId])
  @@index([active, expiresAt])
}

model VoucherRedemption {
  id            String       @id @default(cuid())
  voucherId     String
  appointmentId String?
  paymentId     String?
  amountCents   Int
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  voucher       Voucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payment       Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([voucherId])
  @@index([appointmentId])
  @@index([paymentId])
}

model RecurringSeries {
  id            String        @id @default(cuid())
  customerId    String
  serviceId     String
  staffId       String?
  intervalWeeks Int
  nextAt        DateTime      @db.Timestamptz(3)
  endsAt        DateTime?     @db.Timestamptz(3)
  active        Boolean       @default(true)
  locale        String        @default("en")
  channel       Channel       @default(web)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff         StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  appointments  Appointment[]

  @@index([customerId])
  @@index([serviceId])
  @@index([staffId])
  @@index([active, nextAt])
}

model ReviewRequest {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  sentAt        DateTime?   @db.Timestamptz(3)
  clickedAt     DateTime?   @db.Timestamptz(3)
  platform      String      @default("google")
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([sentAt])
}

model DataRequest {
  id             String            @id @default(cuid())
  customerId     String
  type           DataRequestType
  status         DataRequestStatus @default(pending)
  requestedBy    String?
  completedAt    DateTime?         @db.Timestamptz(3)
  resultLocation String?
  error          String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([status, createdAt])
}
