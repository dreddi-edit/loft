generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  owner
  manager
  staff
}

enum Channel {
  web
  whatsapp
  sms
  voice
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
  no_show
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  refunded
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  locale       String   @default("en")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  staffProfile StaffProfile?
  roles        UserRole[]
}

model Role {
  id        String   @id @default(cuid())
  key       RoleKey  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
}

model StaffProfile {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  displayName     String
  bio             String?
  phone           String?
  locale          String                 @default("en")
  isBookable      Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffServices   StaffService[]
  availability    StaffAvailabilityRule[]
  timeOffs        StaffTimeOff[]
  appointments    Appointment[]
}

model Customer {
  id              String            @id @default(cuid())
  email           String?           @unique
  phone           String?           @unique
  firstName       String
  lastName        String
  locale          String            @default("en")
  sourceChannel   Channel           @default(web)
  marketingOptIn  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  notes           CustomerNote[]
  appointments    Appointment[]
  consents        ConsentRecord[]
  conversations   Conversation[]
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Service {
  id             String               @id @default(cuid())
  slug           String               @unique
  category       String
  durationMin    Int
  bufferAfterMin Int                  @default(10)
  priceCents     Int
  currency       String               @default("EUR")
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  translations   ServiceTranslation[]
  staffServices  StaffService[]
  appointments   Appointment[]
}

model ServiceTranslation {
  id          String   @id @default(cuid())
  serviceId   String
  locale      String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([serviceId, locale])
}

model StaffService {
  id        String       @id @default(cuid())
  staffId   String
  serviceId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([staffId, serviceId])
}

model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startMin  Int
  endMin    Int
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffAvailabilityRule {
  id        String       @id @default(cuid())
  staffId   String
  dayOfWeek Int
  startMin  Int
  endMin    Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffTimeOff {
  id        String       @id @default(cuid())
  staffId   String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                    String                     @id @default(cuid())
  customerId            String
  serviceId             String
  staffId               String?
  startsAt              DateTime
  endsAt                DateTime
  locale                String                     @default("en")
  status                AppointmentStatus          @default(pending)
  sourceChannel         Channel                    @default(web)
  notes                 String?
  cancellationReason    String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  customer              Customer                   @relation(fields: [customerId], references: [id])
  service               Service                    @relation(fields: [serviceId], references: [id])
  staff                 StaffProfile?              @relation(fields: [staffId], references: [id])
  statusHistory         AppointmentStatusHistory[]
  payments              Payment[]
  notifications         NotificationLog[]
}

model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  status        AppointmentStatus
  changedBy     String?
  reason        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String        @id @default(cuid())
  appointmentId    String
  provider         String
  providerIntentId String?
  amountCents      Int
  currency         String        @default("EUR")
  mode             String
  status           PaymentStatus @default(pending)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appointment      Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  refunds          Refund[]
}

model Refund {
  id            String   @id @default(cuid())
  paymentId     String
  amountCents   Int
  reason        String?
  providerRefId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String   @id @default(cuid())
  customerId    String?
  channel       Channel
  locale        String   @default("en")
  externalRef   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer? @relation(fields: [customerId], references: [id])
  messages      Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model CallLog {
  id            String   @id @default(cuid())
  customerId    String?
  locale        String   @default("en")
  fromNumber    String?
  toNumber      String?
  summary       String
  actionTaken   String
  fallback      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model NotificationLog {
  id            String      @id @default(cuid())
  appointmentId String?
  channel       Channel
  recipient     String
  templateKey   String
  payload       Json
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

model ConsentRecord {
  id         String   @id @default(cuid())
  customerId String
  type       String
  granted    Boolean
  source     String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  quantity    Int      @default(0)
  reorderAt   Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  priceCents  Int
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
