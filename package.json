{
  "name": "hair-simo-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @hair-simo/db db:generate",
    "db:migrate": "pnpm --filter @hair-simo/db db:migrate",
    "db:push": "pnpm --filter @hair-simo/db db:push",
    "db:seed": "pnpm --filter @hair-simo/db db:seed",
    "db:setup": "bash scripts/db-setup.sh",
    "bootstrap": "bash scripts/bootstrap-from-github.sh"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
